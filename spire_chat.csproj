<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================================
    Spire Chat - 빌드 설정
    ============================================================================
    설정 근거는 orb_dmg_indicator.csproj와 동일하다(게임 모드 로더 동작 기준).
    각 항목의 상세 근거는 그쪽 주석 참조.
  -->

  <PropertyGroup>
    <!-- 게임 런타임이 net9.0이므로 동일 TFM으로 맞춘다. -->
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>

    <!-- 산출 DLL 이름은 매니페스트의 id와 반드시 같아야 한다(로더가 id + ".dll"로 찾음). -->
    <AssemblyName>spire_chat</AssemblyName>
    <RootNamespace>SpireChat</RootNamespace>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- 게임이 자기 ALC에 우리 DLL을 로드하므로 참조 어셈블리를 같이 배포하면 타입이 충돌한다. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!--
      pdb를 DLL 안에 내장한다. 파일이 하나뿐이라 dll↔pdb 짝이 어긋날 수 없고, 배포물에서
      빠뜨릴 수도 없다 — 유저가 보내온 크래시 로그의 줄 번호를 신뢰할 수 있게 하는 것이 목적이다.
    -->
    <DebugType>embedded</DebugType>

    <!--
      산출물에 빌드 머신의 절대경로(사용자명 포함)가 박히는 것을 막는다. 줄 번호는 그대로 남는다.
      pdb를 빼도 DLL의 디버그 디렉터리에 경로가 남으므로, 치환이 유일한 해결책이다.
    -->
    <PathMap>$(MSBuildProjectDirectory)=/spire_chat</PathMap>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <GameRoot Condition="'$(GameRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</GameRoot>
    <GameData>$(GameRoot)\data_sts2_windows_x86_64</GameData>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameData)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameData)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameData)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGameAssemblies" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(GameData)\sts2.dll')"
           Text="sts2.dll을 찾을 수 없습니다: $(GameData)\sts2.dll — GameRoot 속성을 확인하세요." />
  </Target>

  <PropertyGroup>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
    <ModDeployDir>$(GameRoot)\mods\spire_chat</ModDeployDir>
  </PropertyGroup>

  <Target Name="DeployToMods" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(ModDeployDir)" />
    <ItemGroup>
      <!-- pdb는 DLL에 내장되므로(DebugType=embedded) 따로 복사할 파일이 없다. -->
      <DeployFiles Include="$(OutputPath)spire_chat.dll" />
      <DeployFiles Include="$(MSBuildProjectDirectory)\mod_manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[spire_chat] 배포 완료 → $(ModDeployDir)" />
  </Target>

</Project>
